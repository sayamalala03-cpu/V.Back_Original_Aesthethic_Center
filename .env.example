# Copy to .env.local and fill in. Never commit real values.
# Anything prefixed VITE_ is bundled into the public website, so it must be safe to expose.

# --- Site ---
VITE_SITE_URL=                 # Production domain, for canonical URLs and the sitemap (add when known)

# --- Supabase (booking system, later phase) ---
VITE_SUPABASE_URL=             # Project URL from Supabase > Project Settings > API
VITE_SUPABASE_ANON_KEY=        # The anon (public) key only. Row Level Security protects the data.

# --- Server-only secrets ---
# Do NOT prefix these with VITE_. Store them as Supabase Edge Function secrets
# (supabase secrets set NAME=value), never in frontend code.
# SUPABASE_SERVICE_ROLE_KEY=
# EMAIL_PROVIDER_API_KEY=       # Added when the clinic chooses an email provider
# TURNSTILE_SECRET_KEY=         # Spam protection (Cloudflare Turnstile) if the clinic opts in

# --- Public integrations (only when the clinic supplies them) ---
# VITE_TURNSTILE_SITE_KEY=
# VITE_GA4_MEASUREMENT_ID=
# VITE_WHATSAPP_NUMBER=

# --- Team profiles ---
# Set to true ONLY on a private preview to see draft profiles. Never on the public site.
# VITE_SHOW_DRAFT_PROFILES=
